# =============================================================================
# scan-service 栈统一配置示例
#
# 复制为 .env 后填写，由同目录 docker-compose.yml 注入到各组件容器。
# =============================================================================


# -----------------------------------------------------------------------------
# 宿主机目录
# -----------------------------------------------------------------------------
#
# 这些目录以 bind mount 方式挂进容器。属主需要对容器内的 jenkins 可读写

# 待扫描 RPM 的存放目录（只读挂进容器 /scan-input）
RPM_SCAN_INPUT_HOST_PATH=/srv/scan-service/data/inputs/rpm

# rpm agent 工作目录：remoting + 每个 job 的工作区（挂到 /home/jenkins/agent）
RPM_SCAN_AGENT_WORKSPACE_HOST_PATH=/srv/scan-service/data/rpm-scan-agent/workspace

# cve-bin-tool 漏洞库目录（挂到 /data/cve-db；体积较大，建议放在数据盘）
RPM_SCAN_CVE_DB_HOST_PATH=/srv/scan-service/data/rpm-scan-agent/cve-db


# -----------------------------------------------------------------------------
# 外部 Jenkins（门户与扫描 agent 共用；Jenkins 不在本栈内）
# -----------------------------------------------------------------------------

# 扫描 agent 注册到 Jenkins 的地址
JENKINS_URL=http://jenkins.example:18080

# 门户读取构建信息与产物的 Jenkins API 地址
JENKINS_BASE_URL=http://jenkins.example:18080

# 构建 rpm-scan-agent 镜像时下载 agent.jar 的地址（compose 构建参数）
JENKINS_AGENT_JAR_URL=http://jenkins.example:18080/jnlpJars/agent.jar


# -----------------------------------------------------------------------------
# postgres
# -----------------------------------------------------------------------------

# 数据库初始化密码；必须与下面 scan-results-portal 的 DATABASE_URL 中的密码一致
POSTGRES_PASSWORD=数据库密码


# -----------------------------------------------------------------------------
# scan-results-portal（扫描结果门户）
# -----------------------------------------------------------------------------

# 数据库连接串；容器间通过服务名 postgres 访问
DATABASE_URL=postgresql+psycopg://scanportal:数据库密码@postgres:5432/scanportal

# 只读 Jenkins 账号，用于读取构建信息与归档产物
JENKINS_USER=只读Jenkins账号
JENKINS_TOKEN=只读Jenkins API Token

# Jenkins 回调门户时使用的 Bearer Token，需与 Jenkins 凭据 scan-service-ingest-token 一致
SCAN_SERVICE_INGEST_TOKEN=供Jenkins回调使用的随机Bearer Token

# 页面刷新时最多重新同步的任务数量
RECENT_BUILD_LIMIT=20

# 页面标题
SCAN_SERVICE_TITLE=Scan Results Portal


# -----------------------------------------------------------------------------
# rpm-scan-agent（RPM 漏洞扫描 agent）
# -----------------------------------------------------------------------------

# Jenkins 上的 permanent agent 名称与 inbound secret
RPM_SCAN_AGENT_NAME=rpm-scan-agent-01
RPM_SCAN_AGENT_SECRET=replace-with-jenkins-agent-secret

# cve-bin-tool 执行扫描任务时漏洞库更新模式（由 agent 的持久化缓存提供数据库）
# 勿更改，始终保持为 never
CVE_UPDATE_MODE=never

# 更新漏洞库（update-cve-db）时的锁等待上限（秒）：等待正在运行的扫描结束；
# 0 表示不等待，有扫描在跑就直接放弃本次更新
CVE_DB_UPDATE_LOCK_TIMEOUT=3600

# 更新漏洞库本身的总时长上限（秒）：网络卡住时兜底终止；0 表示不限制
CVE_DB_UPDATE_TIMEOUT=3600

# 门户在栈内的服务名地址，扫描 agent 通过它回传扫描事件；不要改成宿主 IP
# （rpm 与 srpm agent 共用同一个值）
SCAN_RESULTS_PORTAL_URL=http://scan-results-portal:8080


# -----------------------------------------------------------------------------
# srpm-scan-agent（规划中）：实现该组件后再取消注释并填写
# -----------------------------------------------------------------------------

# Jenkins 上的 permanent agent 名称与 inbound secret
#SRPM_SCAN_AGENT_NAME=srpm-scan-agent-01
#SRPM_SCAN_AGENT_SECRET=replace-with-jenkins-agent-secret

# csmock 使用的检查器集合与 mock 配置（可选，按需）
#CSMOCK_TOOLS=
#MOCK_CONFIG=

# 宿主机目录（含义同上面的「宿主机目录」分区）
#SRPM_SCAN_INPUT_HOST_PATH=/srv/scan-service/data/inputs/srpm
#SRPM_SCAN_AGENT_WORKSPACE_HOST_PATH=/srv/scan-service/data/srpm-scan-agent/workspace
#SRPM_SCAN_MOCK_HOST_PATH=/srv/scan-service/data/srpm-scan-agent/mock
